<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiskSpaceTracker.Views.TextPromptWindow"
        x:CompileBindings="True"
        Width="380" Height="170"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="OK"     MinWidth="90" Click="OnOk" IsDefault="True" />
            <Button Content="Cancel" MinWidth="90" Click="OnCancel" IsCancel="True" />
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock x:Name="LabelText" />
            <TextBox x:Name="ValueBox" />
        </StackPanel>
    </DockPanel>
</Window>
