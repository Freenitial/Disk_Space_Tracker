<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiskSpaceTracker.Views.MessageWindow"
        x:CompileBindings="True"
        Width="380" Height="160"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14" LastChildFill="True">
        <Button DockPanel.Dock="Bottom" Content="OK" MinWidth="90" HorizontalAlignment="Right" Click="OnClose" Margin="0,12,0,0" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </DockPanel>
</Window>
