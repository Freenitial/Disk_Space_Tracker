<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskSpaceTracker.ViewModels"
             xmlns:m="using:DiskSpaceTracker.Models"
             x:Class="DiskSpaceTracker.Views.LogsSidebar"
             x:DataType="vm:LogsViewModel"
             x:CompileBindings="True"
             Background="{DynamicResource DstBg}"
             Padding="0"
             Margin="0">

    <!--
      We deliberately do NOT use DataGrid here: the Avalonia 12 Fluent DataGrid template
      reserves a sort glyph + selector area on every column header that truncates short
      labels on narrow widths, and the cells inherit a 12px ContentPresenter padding that
      shifts row text ~1cm to the right and chops it. A plain ListBox + Grid item template
      gives total control over every column width and pixel of padding.
    -->
    <DockPanel LastChildFill="True">
        <!-- Column header strip (matches DataGrid header look) -->
        <Border DockPanel.Dock="Top"
                Height="22"
                Background="{DynamicResource DstTabHeader}"
                BorderBrush="{DynamicResource DstBorder}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="62,62,*">
                <TextBlock Grid.Column="0" Text="Time"
                           Padding="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DstFg}"
                           FontFamily="Arial" FontSize="12" />
                <TextBlock Grid.Column="1" Text="Mode"
                           Padding="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DstFg}"
                           FontFamily="Arial" FontSize="12" />
                <TextBlock Grid.Column="2" Text="Event"
                           Padding="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DstFg}"
                           FontFamily="Arial" FontSize="12" />
            </Grid>
        </Border>

        <!-- Rows -->
        <ListBox ItemsSource="{Binding Entries}"
                 Background="{DynamicResource DstBg}"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="Background" Value="{DynamicResource DstBg}" />
                    <Setter Property="Foreground" Value="{DynamicResource DstFg}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBg"
                                    Background="{TemplateBinding Background}"
                                    Padding="0">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Padding="0" />
                            </Border>
                        </ControlTemplate>
                    </Setter>
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="m:LogEntry">
                    <Border BorderBrush="{DynamicResource DstBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="0">
                        <Grid ColumnDefinitions="62,62,*" Height="20">
                            <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                       Padding="4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DstFg}"
                                       FontFamily="Arial" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Mode}"
                                       Padding="4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DstFg}"
                                       FontFamily="Arial" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                       Padding="4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DstFg}"
                                       FontFamily="Arial" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
