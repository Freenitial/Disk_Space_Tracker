<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="using:DiskSpaceTracker.Converters"
             xmlns:vm="using:DiskSpaceTracker.ViewModels"
             xmlns:ctl="using:DiskSpaceTracker.Controls"
             x:Class="DiskSpaceTracker.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <cv:IsZeroConverter x:Key="IsZeroConverter" />
            <cv:AutoArrowConverter x:Key="AutoArrowConverter" />
            <cv:AutoButtonBackgroundConverter x:Key="AutoButtonBackgroundConverter" />
            <cv:LogsArrowConverter x:Key="LogsArrowConverter" />
            <cv:ComparisonOperatorConverter x:Key="ComparisonOperatorConverter" />
            <cv:StatusColorConverter x:Key="StatusColorConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <!-- Render the preset selector view-model as the PresetMenuButton control. -->
        <DataTemplate DataType="{x:Type vm:PresetSelectorViewModel}">
            <ctl:PresetMenuButton />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Disk_Space_Tracker/Styles/Theme.axaml" />
        <StyleInclude Source="avares://Disk_Space_Tracker/Styles/ControlStyles.axaml" />
    </Application.Styles>
</Application>
